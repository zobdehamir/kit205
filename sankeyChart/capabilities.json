{
    "dataRoles": [
        {
            "displayName": "Key",
            "name": "key",
            "kind": "Grouping"
        },
        {
            "displayName": "Stage",
            "name": "stage",
            "kind": "Grouping"
        },
        {
            "displayName": "Location",
            "name": "location",
            "kind": "Grouping"
        }
    ],
    "objects": {
        "dataPoint": {
            "properties": {
                "defaultColor": {
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "colorByCategory": {
                    "type": {
                        "bool": true
                    }
                }
            }
        },
        "links": {
            "properties": {
                "fill": {
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "linkOpacity": {
                    "type": {
                        "numeric": true
                    }
                },
                "colorMode": {
                    "type": {
                        "enumeration": [
                            { "value": "source", "displayName": "Source location color" },
                            { "value": "gradient", "displayName": "Source-target gradient" },
                            { "value": "uniform", "displayName": "Single color" }
                        ]
                    }
                }
            }
        },
        "nodes": {
            "properties": {
                "nodeWidth": {
                    "type": {
                        "numeric": true
                    }
                },
                "nodePadding": {
                    "type": {
                        "numeric": true
                    }
                }
            }
        },
        "labels": {
            "properties": {
                "show": {
                    "type": {
                        "bool": true
                    }
                },
                "color": {
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "fontSize": {
                    "type": {
                        "formatting": {
                            "fontSize": true
                        }
                    }
                },
                "showValue": {
                    "type": {
                        "bool": true
                    }
                }
            }
        },
        "stageHeaders": {
            "properties": {
                "show": {
                    "type": {
                        "bool": true
                    }
                },
                "color": {
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "fontSize": {
                    "type": {
                        "formatting": {
                            "fontSize": true
                        }
                    }
                }
            }
        },
        "sorting": {
            "properties": {
                "stageOrder": {
                    "type": {
                        "text": true
                    }
                }
            }
        }
    },
    "dataViewMappings": [
        {
            "conditions": [
                { "key": { "max": 1 }, "stage": { "max": 1 }, "location": { "max": 1 } }
            ],
            "table": {
                "rows": {
                    "select": [
                        { "for": { "in": "key" } },
                        { "for": { "in": "stage" } },
                        { "for": { "in": "location" } }
                    ],
                    "dataReductionAlgorithm": {
                        "top": {
                            "count": 30000
                        }
                    }
                }
            }
        }
    ],
    "tooltips": {
        "supportedTypes": {
            "default": true
        },
        "roles": [
            "key",
            "stage",
            "location"
        ]
    }
}
